# Copy to .env and fill in. start.sh loads .env; verify.sh never does.
# The OpenRouter key for the explanation models. Empty turns model help off;
# inspecting readings and saving verdicts still work.
GEOLINEAI_OPENROUTER_API_KEY=
# Optional overrides; the defaults are shown.
# GEOLINEAI_DB_PATH=var/geolineai.db
# GEOLINEAI_HTTP_PORT=18080
